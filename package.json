{
  "name": "boolbul",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-sdk.mjs && next dev",
    "build": "node scripts/build-sdk.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:turso": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-turso.ts",
    "db:sync:tenants": "node --env-file-if-exists=.env.local --import tsx scripts/sync-edge-tenants.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "build:worker": "opennextjs-cloudflare build && node scripts/strip-worker-env.mjs",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "build:sdk": "node scripts/build-sdk.mjs",
    "export:public": "node scripts/export-public.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.48.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.475.0",
    "next": "^15.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
