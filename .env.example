# Cloudflare Worker & R2 (Optional for custom CDN/storage)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="cfat_..."
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Supabase Auth & Public Client
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Turso Edge DB (LibSQL)
TURSO_DATABASE_URL="libsql://[YOUR_DB].turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOi..."

# Dodo Payments (BoolBul SaaS Billing & Verification)
DODO_PAYMENTS_API_KEY="test_[YOUR_DODO_KEY]"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_[YOUR_DODO_WEBHOOK_KEY]"
NEXT_PUBLIC_DODO_ENVIRONMENT="test_mode" # test_mode or live_mode

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BOOLBUL_JWT_SECRET="super-secret-edge-jwt-signing-key"
