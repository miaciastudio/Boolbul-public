# Cloudflare (deploy target: Workers via OpenNext; R2 optional)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="cfat_..."
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Supabase Auth & Public Client
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Turso Edge DB (LibSQL)
TURSO_DATABASE_URL="libsql://[YOUR_DB].turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOi..."

# Dodo Payments (BoolBul SaaS Billing & Verification)
DODO_PAYMENTS_API_KEY="test_[YOUR_DODO_KEY]"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_[YOUR_DODO_WEBHOOK_KEY]"
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_STARTER_PRODUCT_ID=""
DODO_PRO_PRODUCT_ID=""

# Use http://localhost:3000 only for local development.
NEXT_PUBLIC_APP_URL="https://boolbul.com"
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOLBUL_JWT_SECRET=""
# Supabase Auth: set Site URL to https://boolbul.com and allow https://boolbul.com/**.
# Google authorized redirect URI: NEXT_PUBLIC_SUPABASE_URL + /auth/v1/callback.
# BOOLBUL_SIGNING_SECRET lives only on the integrating host backend, never in its browser.
# It is the tenant's signing_secret, not the platform BOOLBUL_JWT_SECRET.

# Self-hosting (open core): remove plan quotas and billing UI.
# BOOLBUL_SELF_HOSTED="true"
# NEXT_PUBLIC_BOOLBUL_SELF_HOSTED="true"
